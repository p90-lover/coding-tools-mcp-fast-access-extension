+export function validatedOAuthEndpoints(mcpUrl, metadata = {}) {
+  const fallback = {...oauthUrlsFromMcpUrl(mcpUrl), metadataStale: false};
+  const pairs = [['authorization_endpoint', 'authorizationUrl'], ['token_endpoint', 'tokenUrl']];
+  for (const [key, target] of pairs) {
+    if (!metadata?.[key]) continue;
+    try {
+      const candidate = new URL(String(metadata[key]));
+      if (candidate.protocol !== 'https:' || candidate.username || candidate.password || candidate.search || candidate.hash || candidate.href !== fallback[target]) {
